+    static double ReadEnvDouble(const char* name, double fallback)
+    {
+        const char* rawValue = std::getenv(name);
+        if (rawValue == nullptr)
+        {
+            return fallback;
+        }
+        char* parseEnd = nullptr;
+        const double parsed = std::strtod(rawValue, &parseEnd);
+        if (parseEnd == rawValue || *parseEnd != '\0' || parsed <= 0.0)
+        {
+            return fallback;
+        }
+        return parsed;
+    }
