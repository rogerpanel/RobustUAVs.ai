# Copy to deploy/mail/.env.mail and fill in. Never commit the real file —
# .gitignore already excludes it, but check before any `git add -A`.

MAIL_HOSTNAME=mail.robustuavs.ai
POSTMASTER_ADDRESS=admin@robustuavs.ai

# ── Optional outbound relay ────────────────────────────────────────────
# Hetzner blocks outbound port 25 on new projects until you ask support to
# lift it. Until then nothing this server sends can reach another mail
# server directly, and a relay on port 587 is the only way to send at all.
# It also carries a warm IP reputation, so mail lands in Gmail/Outlook
# inboxes from day one instead of after a warm-up period.
#
# Leave RELAY_HOST empty to deliver direct. check-mail.sh tests whether
# outbound 25 is actually open — run it before deciding, rather than
# assuming either way.
#
#   SMTP2GO  (free 1,000 msgs/month):   mail.smtp2go.com      587   spf: include:spf.smtp2go.com
#   Brevo    (free 300 msgs/day):       smtp-relay.brevo.com  587   spf: include:spf.brevo.com
#   Amazon SES (~$0.10 / 1,000):        email-smtp.eu-north-1.amazonaws.com 587  spf: include:amazonses.com
#
# Whichever you pick, add its "include:" to the SPF record. setup-mail.sh
# prints the right SPF string for the relay it finds configured here.
RELAY_HOST=
RELAY_PORT=587
RELAY_USER=
RELAY_PASSWORD=

# Seconds to wait for the ACME DNS-01 challenge record to propagate before
# Let's Encrypt validates it. 60 is a safe default for Cloudflare.
ACME_PROPAGATION_SECONDS=60
