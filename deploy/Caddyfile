# /etc/caddy/Caddyfile — robustuavs.ai
#
# Uses a Cloudflare Origin CA certificate rather than Let's Encrypt, so that
# nothing has to renew through the Cloudflare proxy and port 80 never needs to
# be reachable from the public internet (see docs/deployment_runbook.md §2.4).
#
# Install the pair produced in the Cloudflare dashboard as:
#   /etc/caddy/certs/origin.pem   (certificate)
#   /etc/caddy/certs/origin.key   (private key, chmod 600, owner caddy)

{
	# No ACME: certificates are supplied manually.
	email admin@robustuavs.ai

	# Do NOT set `admin off` here. `systemctl reload caddy` works by calling
	# Caddy's admin API, so disabling it makes every reload fail while the
	# old process keeps serving the previous config — a silent no-op that
	# looks like a successful deploy. The endpoint defaults to
	# localhost:2019 and is not reachable from outside the host.
}

(origin_tls) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}
	# No `log` directive: access logs go to stderr and therefore to journald,
	# which the systemd unit already sandboxes correctly. Writing to a file
	# under /var/log adds a permissions surface that `caddy validate` does
	# not check, so a broken setup only shows up as an exit at startup.
	# Read them with:  journalctl -u caddy -f
}

robustuavs.ai, www.robustuavs.ai {
	import origin_tls
	import common

	# Control-plane API. First, so /api never falls through to the SPA
	# handler and answers a JSON request with index.html.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Benchmark artifact: schema, adapters, results, paper PDFs.
	handle_path /artifact/* {
		root * /srv/robustuavs/artifact
		file_server browse
		header Cache-Control "public, max-age=3600"
	}

	# The client used to live here. Kept as a permanent redirect so links in
	# the runbook, the papers, and anyone's bookmarks keep working.
	handle /app* {
		redir * / permanent
	}

	# The interactive client IS the site. try_files sends unknown sub-paths
	# back to index.html so client-side routing survives a refresh.
	#
	# Serving it from the domain root also fixes an asset bug: Expo's export
	# references its bundle at the absolute path /_expo/static/js/web/…, which
	# under a /app/ prefix resolved against the old static root and 404'd.
	handle {
		root * /srv/robustuavs/app
		try_files {path} /index.html
		file_server

		# Hashed bundles may be cached hard; the SPA shell must not be, or a
		# deploy lands on the origin and the browser keeps serving the old
		# index.html pointing at a bundle that no longer exists.
		@shell path / /index.html
		header Cache-Control "public, max-age=300"
		header @shell Cache-Control "no-cache, must-revalidate"

		# Crawler files must be served as themselves rather than falling
		# through try_files to index.html, which would hand a search engine
		# an HTML page where it asked for robots.txt.
		@crawl path /robots.txt /sitemap.xml
		header @crawl Content-Type "text/plain; charset=utf-8"
	}
}
