# Control plane. Install with:
#   sudo install -m644 deploy/robustuavs-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now robustuavs-api
#
# Bound to loopback on purpose: Caddy is the only thing that should reach it,
# and the Cloudflare-ranges firewall rule protects Caddy. Nothing on :8000 is
# ever exposed directly.
[Unit]
Description=RobustUAVs.ai control plane
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory=/srv/robustuavs/repo/platform/backend
Environment="PYTHONUNBUFFERED=1"
# Uncomment for a Postgres/Redis deployment; both fall back safely when unset.
# Environment="DATABASE_URL=postgresql+psycopg://robustuavs:CHANGEME@127.0.0.1/robustuavs"
# Environment="REDIS_URL=redis://127.0.0.1:6379/0"
# Leave API_TOKENS unset for an open demo; set it to require a bearer token
# for run submission (reads stay public either way).
# Environment="API_TOKENS=change-me-1,change-me-2"
EnvironmentFile=-/etc/robustuavs/api.env
ExecStart=/srv/robustuavs/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/srv/robustuavs

[Install]
WantedBy=multi-user.target
