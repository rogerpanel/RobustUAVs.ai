+void Sih::p4_update(const hrt_abstime &now)
+{
+	vehicle_status_s vs;
+
+	if (_vehicle_status_sub.update(&vs)) {
+		const bool armed = (vs.arming_state == vehicle_status_s::ARMING_STATE_ARMED);
+
+		if (armed && !_p4_armed && vs.armed_time > 0) {
+			// arming starts the mission clock: reseed every stream from BEN_SEED
+			const int32_t seed = _ben_seed.get();
+			_p4_arm_time = vs.armed_time;
+			s_p4_imu_rng.seed(paper4::stream_seed(seed, paper4::S_IMU));
+			_p4_gust.init(paper4::stream_seed(seed, paper4::S_GUST), _ben_w_sig.get(), _ben_w_l.get(), _ben_w_v.get());
+			_p4_fault_rng.seed(paper4::stream_seed(seed, paper4::S_FAULT));
+			_p4_bias_y = _ben_b0.get();
+			_p4_step_done = false;
+			PX4_INFO("Paper IV: mission clock started (seed %d)", (int)seed);
+		}
+
+		_p4_armed = armed;
+	}
+
+	if (!_p4_armed) {
+		_p4_wind_I.setZero();
+		_p4_loe = 1.f;
+		_p4_t = -1e9f;
+		return;
+	}
+
+	const float t = (float)((double)(now - _p4_arm_time) * 1e-6) - _ben_toff.get();
+	const float dt = (_p4_t > -1e8f) ? math::max(t - _p4_t, 0.f) : 0.f;
+	_p4_t = t;
+
+	// lateral gust, along BEN_W_DIR (rad from north; pi/2 = east = cross-track)
+	const float w = (float)_p4_gust.at((double)t);
+	const float wd = _ben_w_dir.get();
+	_p4_wind_I = Vector3f(w * cosf(wd), w * sinf(wd), 0.f);
+
+	// accelerometer bias: random walk (BEN_BRW, m/s^2/sqrt(s)) plus one step (BEN_BS_M at BEN_BS_T)
+	if (dt > 0.f) {
+		_p4_bias_y += _ben_brw.get() * sqrtf(dt) * (float)_p4_fault_rng.normal();
+	}
+
+	if (!_p4_step_done && t >= _ben_bs_t.get()) {
+		_p4_bias_y += _ben_bs_m.get();
+		_p4_step_done = true;
+	}
+
+	_p4_loe = (t >= _ben_loe_t.get()) ? (1.f - _ben_loe_m.get()) : 1.f;
