+void Ekf::fuseTrustedAnchor(const extVisionSample &ev_sample)
+{
+	// Paper IV, condition C2': absolute horizontal fix in the EKF's local NED frame
+	if (!_control_status.flags.tilt_align || !_control_status.flags.yaw_align) {
+		return;
+	}
+
+	const Vector2f measurement{ev_sample.pos(0), ev_sample.pos(1)};
+	const Vector2f measurement_var{ev_sample.position_var(0), ev_sample.position_var(1)};
+
+	if (!measurement.isAllFinite() || !measurement_var.isAllFinite()) {
+		return;
+	}
+
+	// gate 1e3 sigma: the anchor is trusted and always fused; its normalised innovation is logged
+	// in estimator_aid_src_ev_pos and the anchor-gate alarm is computed from it offline
+	updateHorizontalPositionAidSrcStatus(ev_sample.time_us, measurement, measurement_var, 1.e3f, _aid_src_ev_pos);
+	_aid_src_ev_pos.fusion_enabled = true;
+	fuseHorizontalPosition(_aid_src_ev_pos);
+}
