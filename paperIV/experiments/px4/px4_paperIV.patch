+/****************************************************************************
+ * Paper IV SITL harness: seeded noise and lateral gust shared by the SIH
+ * simulator and the simulated GPS. Header only.
+ *
+ * Every random input of a mission is drawn from a stream seeded by a PX4
+ * parameter (BEN_SEED, ATK_SEED), reseeded at arming, so a mission and its
+ * benign twin (same seeds, attack off) see the same noise, wind and faults.
+ ****************************************************************************/
+#pragma once
+
+#include <math.h>
+#include <stdint.h>
+
+namespace paper4
+{
+
+// splitmix64 generator with Box-Muller normals
+class Rng
+{
+public:
+	void seed(uint64_t s)
+	{
+		_s = s * 0x9E3779B97F4A7C15ull + 0x632BE59BD9B4E019ull;
+		_has_spare = false;
+	}
+
+	uint64_t next()
+	{
+		uint64_t z = (_s += 0x9E3779B97F4A7C15ull);
+		z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+		z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+		return z ^ (z >> 31);
+	}
+
+	// uniform on [0, 1)
+	double uniform() { return (double)(next() >> 11) * (1.0 / 9007199254740992.0); }
+
+	double normal()
+	{
+		if (_has_spare) {
+			_has_spare = false;
+			return _spare;
+		}
+
+		double u1 = uniform();
+
+		while (u1 <= 1e-300) { u1 = uniform(); }
+
+		const double u2 = uniform();
+		const double r = sqrt(-2.0 * log(u1));
+		_spare = r * sin(2.0 * M_PI * u2);
+		_has_spare = true;
+		return r * cos(2.0 * M_PI * u2);
+	}
+
+private:
+	uint64_t _s{0x853C49E6748FEA9Bull};
+	bool _has_spare{false};
+	double _spare{0.0};
+};
+
+// Lateral Dryden turbulence (MIL-F-8785C), one-sided spatial PSD
+//   Phi_v(Om) = sigma^2 (L / pi) (1 + 3 (L Om)^2) / (1 + (L Om)^2)^2,
+// synthesised as a sum of cosines with random phases and jittered frequencies
+// (spectral representation), scaled to the exact standard deviation sigma.
+// Stateless in time: at(t) can be evaluated by any module at any instant, so
+// the airframe (SIH) and the weather-mimic attacker (GPS) see the same gust.
+class Gust
+{
+public:
+	static constexpr int NW = 64;
+
+	void init(uint64_t seed, double sigma, double L, double V)
+	{
+		_on = (sigma > 0.0) && (L > 0.0) && (V > 0.0);
+
+		if (!_on) { return; }
+
+		Rng r;
+		r.seed(seed);
+		const double w_lo = 0.005, w_hi = 30.0;   // rad/s, temporal
+		const double q = pow(w_hi / w_lo, 1.0 / NW);
+		double var = 0.0;
+
+		for (int i = 0; i < NW; i++) {
+			const double a = w_lo * pow(q, i), b = a * q;
+			const double w = a + r.uniform() * (b - a);
+			const double Om = w / V, x = L * Om;
+			const double phi_t = (L / M_PI) * (1.0 + 3.0 * x * x) / ((1.0 + x * x) * (1.0 + x * x)) / V;
+			_om[i] = w;
+			_amp[i] = sqrt(2.0 * phi_t * (b - a));
+			_ph[i] = 2.0 * M_PI * r.uniform();
+			var += 0.5 * _amp[i] * _amp[i];
+		}
+
+		const double k = sigma / sqrt(var > 0.0 ? var : 1.0);
+
+		for (int i = 0; i < NW; i++) { _amp[i] *= k; }
+	}
+
+	double at(double t) const
+	{
+		if (!_on) { return 0.0; }
+
+		double w = 0.0;
+
+		for (int i = 0; i < NW; i++) { w += _amp[i] * cos(_om[i] * t + _ph[i]); }
+
+		return w;
+	}
+
+private:
+	bool _on{false};
+	double _amp[NW] {};
+	double _om[NW] {};
+	double _ph[NW] {};
+};
+
+// stream identifiers: one independent stream per random input
+enum Stream : uint64_t {
+	S_IMU = 1, S_GUST = 2, S_FAULT = 3, S_GNSS = 4, S_ANCHOR = 5, S_ATTACK = 6
+};
+
+inline uint64_t stream_seed(int32_t seed, Stream s)
+{
+	return (uint64_t)(uint32_t)seed * 1000003ull + (uint64_t)s * 7919ull;
+}
