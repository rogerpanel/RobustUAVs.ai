+SensorGpsSim::P4Out SensorGpsSim::p4_step(const hrt_abstime &now, const vehicle_global_position_s &gpos)
+{
+	P4Out out{};
+	vehicle_status_s vs;
+
+	if (_vehicle_status_sub.update(&vs)) {
+		const bool armed = (vs.arming_state == vehicle_status_s::ARMING_STATE_ARMED);
+
+		if (armed && !_p4_armed && vs.armed_time > 0) {
+			const int32_t seed = _ben_seed.get();
+			_p4_arm_time = vs.armed_time;
+			_p4_gust.init(paper4::stream_seed(seed, paper4::S_GUST), _ben_w_sig.get(), _ben_w_l.get(), _ben_w_v.get());
+			_p4_gnss_rng.seed(paper4::stream_seed(seed, paper4::S_GNSS));
+			_p4_anchor_rng.seed(paper4::stream_seed(seed, paper4::S_ANCHOR));
+			_p4_atk_rng.seed(paper4::stream_seed(_atk_seed.get(), paper4::S_ATTACK));
+			// stationary start of the benign Gauss-Markov drift, as in the reduced-order model
+			_p4_gm_n = _ben_gmsig.get() * (float)_p4_gnss_rng.normal();
+			_p4_gm_e = _ben_gmsig.get() * (float)_p4_gnss_rng.normal();
+			_p4_d = _p4_dd = _p4_beta = _p4_d_prev = 0.f;
+			_p4_agm = 0.f;
+			_p4_t_prev = -1e9f;
+			_p4_next_anchor = (_ben_anc_t.get() > 0.f) ? _ben_anc_t.get() : 1e9f;
+			_p4_terminal_done = false;
+		}
+
+		_p4_armed = armed;
+	}
+
+	if (!_p4_armed) {
+		return out;
+	}
+
+	const float t = (float)((double)(now - _p4_arm_time) * 1e-6) - _ben_toff.get();
+	const float dt = (_p4_t_prev > -1e8f) ? math::max(t - _p4_t_prev, 0.f) : 0.f;
+	_p4_t_prev = t;
+	out.active = true;
+
+	// benign GNSS: white noise (jamming episodes multiply it), Gauss-Markov drift, outage
+	const bool jam = (t >= _ben_jam_t.get()) && (t < _ben_jam_t.get() + _ben_jam_d.get());
+	out.sig = _ben_gsig.get() * (jam ? _ben_jam_k.get() : 1.f);
+
+	if (dt > 0.f && _ben_gmtau.get() > 0.f) {
+		const float phi = expf(-dt / _ben_gmtau.get());
+		const float k = sqrtf(math::max(1.f - phi * phi, 0.f)) * _ben_gmsig.get();
+		_p4_gm_n = phi * _p4_gm_n + k * (float)_p4_gnss_rng.normal();
+		_p4_gm_e = phi * _p4_gm_e + k * (float)_p4_gnss_rng.normal();
+	}
+
+	out.outage = (t >= _ben_out_t.get()) && (t < _ben_out_t.get() + _ben_out_d.get());
+
+	// attacker: scalar offset d(t) along ATK_DIR
+	float d = 0.f;
+
+	if (_atk_en.get() == 1) {
+		d = p4_attack_offset(t, dt);
+	}
+
+	const float c = cosf(_atk_dir.get()), s = sinf(_atk_dir.get());
+	out.dn = _p4_gm_n + d * c;
+	out.de = _p4_gm_e + d * s;
+
+	// a consistent spoofer also shifts the reported velocity by d'(t); a step has no Doppler signature
+	if (_atk_en.get() == 1 && _atk_vcon.get() == 1 && _atk_fam.get() != 0 && dt > 0.f) {
+		const float dv = (d - _p4_d_prev) / dt;
+		out.vn = dv * c;
+		out.ve = dv * s;
+	}
+
+	_p4_d_prev = d;
+
+	debug_vect_s dbg{};
+	dbg.timestamp = hrt_absolute_time();
+	strncpy(dbg.name, "p4atk", sizeof(dbg.name));
+	dbg.x = d;                                   // attack offset [m]
+	dbg.y = out.de;                              // total east offset (attack + benign drift) [m]
+	dbg.z = (float)_p4_gust.at((double)t);       // gust [m/s]
+	_debug_pub.publish(dbg);
+
+	return out;
+}
+
+float SensorGpsSim::p4_attack_offset(float t, float dt)
+{
+	// the five disguise families of the reduced-order model (sim.py), on the mission clock
+	const bool on = t >= _atk_t0.get();
+	const float tt = t - _atk_t0.get();
+
+	switch (_atk_fam.get()) {
+	case 0: // step
+		_p4_d = on ? _atk_a.get() : 0.f;
+		break;
+
+	case 1: // ramp
+		_p4_d = on ? math::min(_atk_r.get() * tt, _atk_cap.get()) : 0.f;
+		break;
+
+	case 2: { // fault mimic: integrated random-walk acceleration
+			_p4_beta += _atk_bsig.get() * sqrtf(dt) * (float)_p4_atk_rng.normal();
+			const float acc = on ? (_atk_b0.get() + _p4_beta) : 0.f;
+			_p4_dd += acc * dt;
+			_p4_d = math::min(on ? (_p4_d + _p4_dd * dt) : 0.f, _atk_cap.get());
+
+			if (_p4_d >= _atk_cap.get()) { _p4_dd = 0.f; }
+
+			break;
+		}
+
+	case 3: { // GNSS mimic: Gauss-Markov magnitude plus a slow drift
+			if (dt > 0.f) {
+				const float phi = expf(-dt / math::max(_atk_tau.get(), 1e-3f));
+				_p4_agm = phi * _p4_agm + sqrtf(math::max(1.f - phi * phi, 0.f)) * (float)_p4_atk_rng.normal();
+			}
+
+			_p4_d = on ? (_atk_a.get() * fabsf(_p4_agm) + _atk_c.get() * math::max(tt, 0.f)) : 0.f;
+			break;
+		}
+
+	case 4: { // weather mimic: follows the airframe's gust with a lag, plus a bias ramp
+			const float wl = (float)_p4_gust.at((double)(t - _atk_lag.get()));
+			_p4_d = on ? (_atk_a.get() * wl / math::max(_atk_wnrm.get(), 1e-6f)
+				      + _atk_wb.get() * math::min(tt / 10.f, 1.f)) : 0.f;
+			break;
+		}
+
+	default:
+		_p4_d = 0.f;
+		break;
+	}
+
+	return _p4_d;
+}
+
+void SensorGpsSim::p4_anchor(const hrt_abstime &now, const vehicle_local_position_s &lpos_gt,
+			     const vehicle_global_position_s &gpos)
+{
+	// trusted re-anchoring fix (condition C2'): true position plus noise, expressed in the EKF's
+	// local frame, every BEN_ANC_T s of mission time and once at the end of the mission (BEN_T_END)
+	_ekf_local_position_sub.update(&_ekf_lpos);
+
+	if (!_p4_armed || _ben_anc_t.get() <= 0.f || !_ekf_lpos.xy_global || !_ekf_lpos.z_global) {
+		return;
+	}
+
+	const float t = (float)((double)(now - _p4_arm_time) * 1e-6) - _ben_toff.get();
+	bool fire = false;
+
+	if (t >= _p4_next_anchor && t < _ben_t_end.get()) {
+		fire = true;
+		_p4_next_anchor += _ben_anc_t.get();
+
+	} else if (!_p4_terminal_done && t >= _ben_t_end.get()) {
+		fire = true;
+		_p4_terminal_done = true;
+	}
+
+	if (!fire) {
+		return;
+	}
+
+	MapProjection ref{_ekf_lpos.ref_lat, _ekf_lpos.ref_lon};
+	float x = 0.f, y = 0.f;
+	ref.project(gpos.lat, gpos.lon, x, y);
+	const float sig = _ben_anc_sig.get();
+
+	vehicle_odometry_s odom{};
+	odom.timestamp_sample = gpos.timestamp_sample;
+	odom.pose_frame = vehicle_odometry_s::POSE_FRAME_NED;
+	odom.position[0] = x + sig * (float)_p4_anchor_rng.normal();
+	odom.position[1] = y + sig * (float)_p4_anchor_rng.normal();
+	odom.position[2] = _ekf_lpos.ref_alt - gpos.alt;
+	odom.q[0] = NAN; odom.q[1] = NAN; odom.q[2] = NAN; odom.q[3] = NAN;
+	odom.velocity_frame = vehicle_odometry_s::VELOCITY_FRAME_UNKNOWN;
+	odom.velocity[0] = NAN; odom.velocity[1] = NAN; odom.velocity[2] = NAN;
+	odom.angular_velocity[0] = NAN; odom.angular_velocity[1] = NAN; odom.angular_velocity[2] = NAN;
+	odom.position_variance[0] = sig * sig; odom.position_variance[1] = sig * sig; odom.position_variance[2] = 1.f;
+	odom.orientation_variance[0] = NAN; odom.orientation_variance[1] = NAN; odom.orientation_variance[2] = NAN;
+	odom.velocity_variance[0] = NAN; odom.velocity_variance[1] = NAN; odom.velocity_variance[2] = NAN;
+	odom.reset_counter = 0;
+	odom.quality = -77;   // Ekf::kTrustedAnchorQuality
+	odom.timestamp = hrt_absolute_time();
+	_anchor_pub.publish(odom);
+
+	debug_vect_s dbg{};
+	dbg.timestamp = hrt_absolute_time();
+	strncpy(dbg.name, "p4anc", sizeof(dbg.name));
+	dbg.x = odom.position[0];
+	dbg.y = odom.position[1];
+	dbg.z = t;
+	_debug_pub.publish(dbg);
+	(void)lpos_gt;
+}
